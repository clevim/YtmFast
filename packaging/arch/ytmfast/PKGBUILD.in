# Maintainer: clevim <clever.filho at gmail dot com>
# Built from source. The release workflow fills in @VERSION@ and @SHA256_SOURCE@.
pkgname=ytmfast
pkgver=@VERSION@
pkgrel=1
pkgdesc="A native YouTube Music client"
arch=('x86_64' 'aarch64')
url="https://github.com/clevim/YtmFast"
license=('MIT')
depends=('mpv' 'yt-dlp' 'sqlite' 'dbus' 'libglvnd' 'libxkbcommon' 'wayland' 'hicolor-icon-theme')
optdepends=('pipewire: real spectrum in the compact player'
            'noto-fonts: Noto Sans fallback when Roboto is missing')
makedepends=('cargo')
# GCC's LTO objects (makepkg's default) can't be linked by rustc's linker: the C parts of the
# dependencies (ring, QuickJS) would come out as undefined symbols.
options=('!lto')
source=("$pkgname-$pkgver.tar.gz::https://github.com/clevim/YtmFast/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('@SHA256_SOURCE@')

prepare() {
  cd "YtmFast-$pkgver"
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "YtmFast-$pkgver"
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release
}

check() {
  cd "YtmFast-$pkgver"
  cargo test --frozen --release
}

package() {
  cd "YtmFast-$pkgver"
  install -Dm755 target/release/ytmfast "$pkgdir/usr/bin/ytmfast"
  install -Dm644 packaging/linux/ytmfast.desktop "$pkgdir/usr/share/applications/ytmfast.desktop"
  install -Dm644 packaging/linux/ytmfast.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/ytmfast.svg"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
